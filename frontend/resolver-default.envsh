#!/bin/sh
# Sourced by the stock nginx entrypoint after 15-local-resolvers.envsh and before
# 20-envsubst-on-templates.sh (ordering is by filename; this is installed as 16-).
#
# 15-local-resolvers.envsh fills NGINX_LOCAL_RESOLVERS from the nameserver lines in
# /etc/resolv.conf, which is the correct resolver on every runtime: Docker's 127.0.0.11 on a
# user-defined network, the gateway DNS on Podman, the cluster DNS on Kubernetes (#448).
# If that file names no nameserver at all the variable is exported empty, and the template
# would render `resolver  valid=10s;` — a config error that leaves the container dead and
# the user with nothing to read. Fall back to 127.0.0.11 instead: on that one broken
# environment the proxy then behaves exactly as it did before #448, which is at worst the
# old failure rather than a new one.
set -eu

: "${NGINX_LOCAL_RESOLVERS:=127.0.0.11}"
export NGINX_LOCAL_RESOLVERS
